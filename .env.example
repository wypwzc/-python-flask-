# ===== Docker 部署配置模板 =====
# 复制为 .env 并修改后使用：cp .env.example .env
# 注意：.env 已被 git 忽略，不会提交到仓库，请勿删除本模板

# 数据库 root 密码（务必修改为强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# 会话密钥（生成方式：openssl rand -hex 32）
SECRET_KEY=

# 邮件通知（可选，留空则不发邮件，不影响功能）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=admin@example.com

# 首次部署是否创建示例文章（true/false）
CREATE_SAMPLE_DATA=true
